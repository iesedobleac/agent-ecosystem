{
  "name": "sdd-tasks",
  "description": "Decomposes an approved plan into dependency-ordered tasks estimated under 30 minutes, with RF links, unchecked checkboxes, and verifiable completion criteria; saves only approved ai/specs/<name>/tasks.md.",
  "mode": "subagent",
  "profile": "analyst",
  "hidden": false,
  "steps": null,
  "rules": [
    [
      "*",
      "*",
      "deny"
    ],
    [
      "read",
      "*",
      "allow"
    ],
    [
      "read",
      "*.env",
      "ask"
    ],
    [
      "read",
      "*.env.*",
      "ask"
    ],
    [
      "read",
      "*.env.example",
      "allow"
    ],
    [
      "grep",
      "*",
      "allow"
    ],
    [
      "glob",
      "*",
      "allow"
    ],
    [
      "list",
      "*",
      "allow"
    ],
    [
      "codegraph_*",
      "*",
      "allow"
    ],
    [
      "execute",
      "*",
      "allow"
    ],
    [
      "edit",
      "*",
      "deny"
    ],
    [
      "edit",
      "specs/*/tasks.md",
      "allow"
    ],
    [
      "edit",
      "**/specs/*/tasks.md",
      "allow"
    ],
    [
      "edit",
      "@@OPENCODE_TMP@@/sdd-drafts/*",
      "allow"
    ],
    [
      "external_directory",
      "@@OPENCODE_TMP@@/*",
      "allow"
    ],
    [
      "external_directory",
      "@@OPENCODE_TOOL_OUTPUT@@/*",
      "allow"
    ]
  ]
}
